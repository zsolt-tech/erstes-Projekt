{
  "name": "agentur-verwaltung",
  "version": "0.1.0",
  "private": true,
  "description": "Lokale Verwaltung von Kunden, Projekten und Aufgaben für Videoproduktion und Social-Media-Betreuung",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning scripts/start.mjs",
    "dev": "concurrently -k -n server,client -c blue,green \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "node --disable-warning=ExperimentalWarning --import tsx --watch server/index.ts",
    "dev:client": "vite",
    "build": "vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p client/tsconfig.json --noEmit",
    "test": "node --disable-warning=ExperimentalWarning --import tsx --test tests/*.test.ts",
    "restore": "node --disable-warning=ExperimentalWarning scripts/restore-backup.mjs"
  },
  "dependencies": {
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/utilities": "3.2.2",
    "@fullcalendar/core": "6.1.15",
    "@fullcalendar/daygrid": "6.1.15",
    "@fullcalendar/interaction": "6.1.15",
    "@fullcalendar/list": "6.1.15",
    "@fullcalendar/react": "6.1.15",
    "@fullcalendar/timegrid": "6.1.15",
    "@tailwindcss/vite": "4.1.18",
    "@tanstack/react-query": "5.62.16",
    "@vitejs/plugin-react": "4.7.0",
    "dotenv": "16.6.1",
    "express": "4.22.3",
    "lucide-react": "0.468.0",
    "open": "10.2.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "6.30.6",
    "tailwindcss": "4.1.18",
    "tsx": "4.19.4",
    "vite": "6.4.5",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/express": "4.17.25",
    "@types/node": "22.20.5",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "concurrently": "9.2.5",
    "typescript": "5.9.3"
  }
}
