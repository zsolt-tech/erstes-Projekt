# Agentur-Verwaltung: Konfiguration
# Diese Datei wird beim ersten Start automatisch nach .env kopiert.
# Die .env enthält Zugangsdaten und wird niemals ins Git eingecheckt.

# Port der App (Adresse: http://localhost:PORT)
PORT=3000

# Geheimer Schlüssel zum Verschlüsseln der Google-Zugangstokens.
# Wird beim ersten Start automatisch erzeugt. Nicht ändern, sonst muss Google neu verbunden werden.
APP_SECRET=

# Browser beim Start automatisch öffnen (true/false)
OPEN_BROWSER=true

# Speicherort der Datenbank
DATA_DIR=./data

# Datensicherung
BACKUP_DIR=./backups
# Optional: zweiter Speicherort, z. B. ein Ordner, der mit iCloud, OneDrive oder Google Drive synchronisiert wird
BACKUP_EXTRA_DIR=
# Wie viele Tage tägliche Sicherungen aufbewahrt werden (zusätzlich bleibt je Monat eine Sicherung 12 Monate erhalten)
BACKUP_KEEP_DAYS=30

# Google-Anbindung (Einrichtung siehe docs/GOOGLE-EINRICHTUNG.md; die Zugangsdaten trägt die App beim Verbinden selbst ein)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/google/callback
